{% extends "base_layout" %}

{# Layout for pages marked `module = true` in pages.toml. The whole page body
   is rendered by the Vue entry web/src/pages/<template_name>.ts, which
   base_layout loads together with the JSON page context. #}
{% block base_content %}
<div id="app"></div>

{# Footer #}
<div class="sticky-bottom bg-body mt-5 mx-2 text-secondary d-print-none z-n1">
    <p>&copy; 2024 &ndash; 2025 Neil Bartlett all rights reserved.</p>
</div>
{% endblock %}
