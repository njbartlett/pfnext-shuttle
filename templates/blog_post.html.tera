{% extends "default_layout" %}

{% block content %}
<div class="container">
    <div class="mt-2 mx-auto text-center">
        <h1 class="display-4 fw-normal text-body-emphasis">{{page.title}}</h1>
    </div>

    <div class="text-center mt-2 mx-1">
        <span class="text-body-secondary">
            Created by {{post_author_name}} <span class="fst-italic">on {{post_created_at | date(format = "%d %B %Y")}}</span>, last edited by {{post_last_editor_name}} <span class="fst-italic">on {{post_last_edited_at | date(format = "%d %B %Y")}}</span>.
        </span>
        {% if post_published %}
        <br>
        <span class="text-body-secondary">
            Published <span class="fst-italic">on {{post_published | date(format = "%d %B %Y")}}</span>.
        </span>
        {% else %}
        <br>
        <span class="text-danger">
            <i class="bi bi-exclamation-circle"></i> Unpublished Draft
        </span>
        {% endif %}
    </div>


    <!-- Admin Only Card -->
    <div v-cloak v-if="isEditor()" class="alert alert-warning my-3 position-relative">
        <div class="position-absolute top-0 end-0"><i class="bi bi-lightning-fill" title="Admin/Editor Only"></i></div>

        <div class="d-flex">
            <a class="btn btn-primary btn-sm ms-auto" href="../edit/{{post_title | urlencode}}.html"><i class="bi bi-feather"></i>&nbsp;Edit Post</a>
            {# <button class="btn btn-danger btn-sm ms-1" @click="deletePost()"><i class="bi bi-trash"></i>&nbsp;Delete Post</button> #}
            <button type="button" class="btn btn-danger btn-sm ms-1" data-bs-toggle="modal" data-bs-target="#deleteConfirmDialog"><i class="bi bi-trash"></i> Delete</button>
        </div>
    </div>

    <!-- Deletion Confirm Dialog -->
    <div v-cloak class="modal fade" id="deleteConfirmDialog" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header text-bg-danger">
                    <h5 class="modal-title" id="deleteConfirmModalLabel"><i class="bi bi-exclamation-triangle-fill"></i>&nbsp;Delete Post</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this Post?</p>
                    <p>This cannot be undone!</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" @click="confirmedDeletePost()" data-bs-dismiss="modal"><i class="bi bi-trash"></i> Delete</button>
                </div>
            </div>
        </div>
    </div> <!-- End deletion confirm dialog -->

    <div class="d-flex my-3">
        <a href="/blog/index.html">&laquo; Return to List of Posts</a>
    </div>

    {{post_content}}

</div>

{% endblock %}

{% block extra_script %}
<script>
    postMeta.value.id = {{post_id}}
    postMeta.value.title = '{{post_title}}'
</script>
{% endblock %}