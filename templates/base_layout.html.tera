<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{{page.title}} &ndash; {{common.branding}}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    {# <link rel="manifest" href="/site.webmanifest"> #}
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#333333">

    <link href="/styles/bootstrap.min.css" rel="stylesheet">
    <link href="/styles/al.css" rel="stylesheet" >
    <link href="/styles/bootstrap-icons.min.css" rel="stylesheet" >

    <script src="/js/theme.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/lodash.min.js"></script>
    {% block extra_head %}{% endblock %}
</head>
<body>

    {% block base_content %}{% endblock %}

</body>

{% if prod %}
<script src="/js/vue.global.prod.js"></script>
{% else %}
<script src="/js/vue.global.js"></script>
{% endif %}

<script src="/js/library.js"></script>


{% if page.scripted %}
<script src="/js/{{page.template_name}}.js"></script>
{% else %}
{# Simple static page setup #}
<script>
    let app = createApp({
        setup() {
            return {
                loggedin, onLogout, isAdmin, http_err
            }
        }
    })
    app.config.compilerOptions.delimiters = ['${', '}']
    app.mount('#app')
</script>
{% endif %}
{% block extra_script %}{% endblock%}

</html>